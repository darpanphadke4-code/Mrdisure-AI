# MediSure AI Backend Environment Configuration
# Copy this file to .env and configure your environment values.

# Database URL:
# For PostgreSQL (default production target):
# DATABASE_URL=postgresql+psycopg://postgres:your_password@localhost:5432/medisure_ai
# For SQLite (local development/testing fallback):
DATABASE_URL=sqlite:///./medisure.db

# Server Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
DEBUG=True

# Upload & File Limits
MAX_UPLOAD_SIZE_MB=25
UPLOAD_DIR=./uploads

# OCR Configuration (Path to Tesseract binary if not in system PATH)
# Windows example: TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# Linux example: TESSERACT_CMD=/usr/bin/tesseract
TESSERACT_CMD=

# Security
SECRET_KEY=change_this_to_a_secure_random_key_in_production
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Step 3: Local RAG (Ollama & ChromaDB) Configuration
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_LLM_MODEL=qwen3:4b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
CHROMA_PERSIST_DIRECTORY=./data/chroma
RAG_TOP_K=5
RAG_MIN_RELEVANCE=0.30
